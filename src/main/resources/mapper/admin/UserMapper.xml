    <update id="mergeInitialAdmin">

        MERGE INTO S2C_USER T
            USING (SELECT #{loginId} LOGIN_ID FROM DUAL) S
            ON (T.LOGIN_ID = S.LOGIN_ID)
        WHEN NOT MATCHED THEN
            INSERT (
                LOGIN_ID,
                USER_NAME,
                COMPANY_ID,
                AUTH_TYPE,
                PASSWORD_HASH,
                USER_STATUS,
                FAILED_LOGIN_COUNT,
                MUST_CHANGE_PASSWORD_YN,
                USE_YN,
                CREATED_AT,
                CREATED_BY
            ) VALUES (
                #{loginId},
                #{userName},
                #{companyId},
                'LOCAL',
                #{passwordHash},
                'ACTIVE',
                0,
                'Y',
                'Y',
                SYSTIMESTAMP,
                #{createdBy}
            )

    </update>

    <select id="countCompanyByCode" resultType="int">
        SELECT COUNT(*)
        FROM S2C_COMPANY
        WHERE COMPANY_CODE = #{companyCode}
    </select>

    <select id="countActiveCompanyByCode" resultType="int">
        SELECT COUNT(*)
        FROM S2C_COMPANY
        WHERE COMPANY_CODE = #{companyCode}
        AND USE_YN = 'Y'
    </select>

    <select id="countConformingInitialAdmin" resultType="int">
        SELECT COUNT(*)
        FROM S2C_USER U
        JOIN S2C_COMPANY C ON C.COMPANY_ID = U.COMPANY_ID
        WHERE U.USER_ID = #{userId}
        AND UPPER(U.LOGIN_ID) = UPPER(#{loginId})
        AND U.AUTH_TYPE = 'LOCAL'
        AND U.USER_STATUS = 'ACTIVE'
        AND U.USE_YN = 'Y'
        AND U.PASSWORD_HASH IS NOT NULL
        AND C.COMPANY_CODE = #{companyCode}
        AND C.USE_YN = 'Y'
    </select>


</mapper>
