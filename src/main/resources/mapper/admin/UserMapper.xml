<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.soft2cost2.admin.mapper.UserMapper">

    <!-- =====================================================
         LOGIN_ID로 USER_ID 조회
         ===================================================== -->
    <select id="selectUserIdByLoginId" resultType="java.lang.Long">

        SELECT USER_ID FROM S2C_USER WHERE UPPER(LOGIN_ID) = UPPER(#{loginId})

    </select>

    <!-- =====================================================
         Bootstrap용 회사 조회
         ===================================================== -->

    <select id="selectCompanyIdByCode" resultType="java.lang.Long">

        SELECT COMPANY_ID FROM S2C_COMPANY WHERE COMPANY_CODE = #{companyCode} AND USE_YN = 'Y'

    </select>

